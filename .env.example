# Keep all secret keys on the server. Never prefix secrets with NEXT_PUBLIC_.

# ── AI provider (claim extraction, classification, research planning)
# "anthropic" (default) or "openai-compatible".
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional for anthropic (defaults to claude-opus-5-5); required for openai-compatible.
AI_MODEL=
# Required only for openai-compatible, e.g. https://api.example.com/v1
AI_API_BASE_URL=

# ── Web search (Brave Search API)
SEARCH_API_KEY=
# Optional override of the Brave endpoint.
SEARCH_API_BASE_URL=

# ── Google Fact Check Tools API (optional, adds published fact-checks)
GOOGLE_FACT_CHECK_API_KEY=

# ── Supabase accounts (setup steps in README → "Accounts with Supabase")
# The anon key is public by design; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not used by the app. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# true = ignore all provider keys above. Without keys the engine runs in
# rule-based mode and clearly reports what it could not do.
ORIVIO_DEMO_MODE=false
